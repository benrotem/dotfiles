# This file is located at ~/.config/task/taskrc, so update location config accordingly:
data.location=~/.local/share/task
hooks.location=~/.config/task/hooks

# Color theme (uncomment one to use)
#include light-16.theme
#include light-256.theme
#include bubblegum-256.theme
#include dark-16.theme
#include dark-256.theme
#include dark-red-256.theme
#include dark-green-256.theme
#include dark-blue-256.theme
#include dark-violets-256.theme
#include dark-yellow-green.theme
#include dark-gray-256.theme
#include dark-gray-blue-256.theme
#include solarized-dark-256.theme
#include solarized-light-256.theme
#include no-color.theme

# Define an 'Inbox' list, the singular funnel to capture all 'stuff'; sorted by age.
report.inbox.columns=id,entry.age,description
report.inbox.labels=ID,Age,Description
report.inbox.filter=status:pending +in
report.inbox.sort=entry+

# Define a 'Someday' list for ideas we may want to address in the future.
report.someday.columns=id,project,description
report.someday.labels=ID,Project,Description
report.someday.filter=status:pending +someday

# Define a 'Waiting-for' list for items delegated to someone else.
uda.who.type=string
uda.who.label=Who
report.awaiting.columns=id,entry.age,who,project,description
report.awaiting.labels=ID,Age,Who,Project,Description
report.awaiting.filter=status:pending +awaiting

# Hide blocked tasks and custom lists in 'next' report.
report.next.filter=+READY -in -someday -awaiting limit:page

news.version=3.4.2
